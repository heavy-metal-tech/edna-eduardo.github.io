# Copie para .env e preencha com seus valores

# Neon PostgreSQL — copie a connection string do painel Neon
DATABASE_URL=postgresql://usuario:senha@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# URL do frontend (para CORS)
FRONTEND_URL=https://eeimoveis.onrender.com

# JWT — troque por uma string aleatória longa
JWT_SECRET=troque-por-string-aleatoria-segura-aqui

# Credenciais do admin
ADMIN_USER=admin
# Hash bcrypt da senha. Gere com: node -e "console.log(require('bcryptjs').hashSync('suasenha', 10))"
ADMIN_HASH=$2a$10$SUBSTITUA_PELO_HASH_REAL_DA_SUA_SENHA
